diff --git a/tests/cpp/asr/test_diar_state.cpp b/tests/cpp/asr/test_diar_state.cpp
index 2c3e410..240cb36 100644
--- a/tests/cpp/asr/test_diar_state.cpp
+++ b/tests/cpp/asr/test_diar_state.cpp
@@ -151,6 +151,26 @@ test_geometry_and_word_cadence() {
     require(model.word_anchor_frames() == 16, "V3 word anchor must be sixteen frames");
 }
 
+void
+test_model_geometry() {
+    auto g = DiarGeometry::for_model("streaming", false);
+    require(g.chunk_len == 20 && g.spkcache_len == 160, "V2 streaming is riva streaming");
+    g = DiarGeometry::for_model("offline", false);
+    require(g.chunk_len == 100 && g.spkcache_len == 312, "V2 offline is riva offline");
+    g = DiarGeometry::for_model("streaming", true);
+    require(g.chunk_len == 13 && g.fifo_len == 80, "V3 streaming is v3 streaming");
+    g = DiarGeometry::for_model("offline", true);
+    require(g.chunk_len == 264 && g.fifo_len == 0, "V3 offline is v3 offline");
+    bool threw = false;
+    try {
+        DiarGeometry::for_model("v3-offline", true);
+    }
+    catch (const std::invalid_argument&) {
+        threw = true;
+    }
+    require(threw, "only streaming and offline name a model's geometry");
+}
+
 void
 test_finite_parity() {
     const float nan = std::numeric_limits<float>::quiet_NaN();
@@ -274,6 +294,7 @@ main() {
     }
     test_birth_gate_settled_frames();
     test_geometry_and_word_cadence();
+    test_model_geometry();
     test_finite_parity();
     test_invalid_rotary_geometry();
     test_buffer_compaction();
