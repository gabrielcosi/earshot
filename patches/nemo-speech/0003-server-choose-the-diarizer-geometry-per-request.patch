 server/http/http_server.cpp       | 10 +++++++++-
 src/asr/diar/aosc_state.cpp       |  7 +++++++
 src/asr/diar/aosc_state.h         |  3 +++
 src/asr/diar/diarizer.cpp         | 10 ++++++++++
 src/asr/diar/diarizer.h           |  6 ++++++
 tests/cpp/asr/test_diar_state.cpp | 21 +++++++++++++++++++++
 7 files changed, 64 insertions(+), 4 deletions(-)

diff --git a/docs/api.md b/docs/api.md
index faf1735..9b8bcfd 100644
--- a/docs/api.md
+++ b/docs/api.md
@@ -343,14 +343,19 @@ Speaker segmentation without transcription. Alias: `/v1/diarizations`.
 |---|---|---|---|
 | `file` | WAV upload | required | audio to segment |
 | `mode` | string | `streaming` | `streaming` for long-form audio, or full-attention `offline` for recordings up to about 6.6 minutes |
+| `geometry` | string | the server's diarizer geometry | for `mode=streaming`: the loaded model's `streaming` or long-chunk `offline` geometry (`v3-streaming` or `v3-offline` on V3, `streaming` or `offline` on V2) |
 
 Response: `{"segments": [{"start": s, "end": s, "speaker": n}]}` (1-based
 speaker ids).
 
 Request `mode=offline` uses full attention. It is distinct from
-`diar.preset: offline`, which still uses the streaming path.
+`diar.preset: offline` and `geometry=offline`, which still use the streaming path
+with longer chunks: much faster than the low-latency default on a whole
+recording. Unlike `diar.preset`, whose names are fixed presets (`offline` is
+the V2 one even on V3), `geometry` follows the loaded model's version. It is
+ignored with `mode=offline`.
 
 Without a diarization model, a speech-LLM (SALM) model answers
 with its encoder's speaker branch and no transcript: the 10 ms speaker turns its
-word timestamps carry (activity above 0.5), whatever the `mode`. It needs the
-CTC timestamp head, like word timestamps.
+word timestamps carry (activity above 0.5), whatever the `mode` and `geometry`.
+It needs the CTC timestamp head, like word timestamps.
diff --git a/server/http/http_server.cpp b/server/http/http_server.cpp
index 591e348..f839cdf 100644
--- a/server/http/http_server.cpp
+++ b/server/http/http_server.cpp
@@ -1055,6 +1055,11 @@ struct Server::Impl {
                 request.form.has_field("mode") ? request.form.get_field("mode") : "streaming";
             if (mode != "streaming" && mode != "offline")
                 throw std::invalid_argument("mode must be streaming or offline");
+            // The geometry of a streaming pass; the server's configured one when absent.
+            const std::string geometry =
+                request.form.has_field("geometry") ? request.form.get_field("geometry") : "";
+            if (!geometry.empty() && geometry != "streaming" && geometry != "offline")
+                throw std::invalid_argument("geometry must be streaming or offline");
             Value root(Value::Object{});
             Value::Array output;
             const auto segment_item = [&](double start, double end, int speaker) {
@@ -1085,7 +1090,10 @@ struct Server::Impl {
                     throw;
             }
             if (engine) {
-                const auto result = engine->diarize(
+                const auto diarizer = geometry.empty()
+                                          ? *engine
+                                          : engine->with_geometry(engine->model_geometry(geometry));
+                const auto result = diarizer.diarize(
                     source.samples.data(), source.samples.size(), source.sample_rate,
                     mode == "offline" ? asr::DiarizationMode::Offline
                                       : asr::DiarizationMode::Streaming);
diff --git a/src/asr/diar/aosc_state.cpp b/src/asr/diar/aosc_state.cpp
index 797a40d..03ebd4a 100644
--- a/src/asr/diar/aosc_state.cpp
+++ b/src/asr/diar/aosc_state.cpp
@@ -196,6 +196,13 @@ DiarGeometry::preset(const std::string& name) {
         "' (expected streaming | offline | v3-streaming | v3-offline)");
 }
 
+DiarGeometry
+DiarGeometry::for_model(const std::string& name, bool is_v3) {
+    if (name != "streaming" && name != "offline")
+        throw std::invalid_argument("diarizer geometry must be streaming or offline");
+    return preset(is_v3 ? "v3-" + name : name);
+}
+
