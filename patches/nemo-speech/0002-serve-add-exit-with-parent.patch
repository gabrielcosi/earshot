From bbecc6baee6923586d777379561edb81a22ffac1 Mon Sep 17 00:00:00 2001
From: Gabriel Cosi <contact@gabrielcosi.dev>
Date: Fri, 25 Sep 2026 11:34:43 +0200
Subject: [PATCH 2/2] serve: add --exit-with-parent

---
 app/serve.cpp               | 48 ++++++++++++++++++++++++++++++++++---
 server/http/http_server.cpp |  5 ++++
 server/http/http_server.h   |  3 +++
 3 files changed, 53 insertions(+), 3 deletions(-)

diff --git a/app/serve.cpp b/app/serve.cpp
index f5d85c2..06e062a 100644
--- a/app/serve.cpp
+++ b/app/serve.cpp
@@ -13,6 +13,9 @@
 #include <stdexcept>
 #include <string>
 #include <thread>
+#if !defined(_WIN32)
+#include <unistd.h>
+#endif
 #include <utility>
 #include <vector>
 
@@ -130,6 +133,11 @@ run_server(int argc, char** argv) {
     bool device_set = false;
     bool no_warmup = false;
     bool open_browser = false;
+    bool exit_with_parent = false;
+#if !defined(_WIN32)
+    // Read before the models load, so a parent that exits while they load is still noticed.
+    const pid_t parent = getppid();
+#endif
     bool http_threads_set = false;
 #if defined(NEMO_SPEECH_CLI_ASR)
     nemo_speech::asr::RecognizerConfig asr_config;
@@ -337,6 +345,17 @@ run_server(int argc, char** argv) {
             server_config.enable_playground = false;
         else if (arg == "--open")
             open_browser = true;
+        else if (arg == "--exit-with-parent") {
+#if defined(_WIN32)
+            throw std::invalid_argument("--exit-with-parent is not supported on Windows");
+#else
+            exit_with_parent = true;
+            // The parent exited before `parent` was read, and launchd adopted this process.
+            if (parent == 1)
+                throw std::runtime_error(
+                    "--exit-with-parent: the parent process has already exited");
+#endif
+        }
         else if (arg == "--gpu") {
             gpu = parse_int(value(i, arg), arg, -1, 1024);
             device_name = gpu < 0 ? "cpu" : "gpu:" + std::to_string(gpu);
@@ -673,13 +692,35 @@ run_server(int argc, char** argv) {
         std::signal(SIGINT, old_int);
         std::signal(SIGTERM, old_term);
     });
+#if !defined(_WIN32)
+    // A server started by an app must not outlive it: when the parent exits, however it
+    // exits, the server is re-parented and getppid() changes. Unlike a parent PID, this
+    // cannot be fooled by the PID being reused.
+    auto parent_exited = [&] { return exit_with_parent && getppid() != parent; };
+#else
+    auto parent_exited = [] { return false; };
+#endif
+    std::atomic<bool> serving_done{false};
     std::thread shutdown_watcher([&] {
-        while (!shutdown_requested.load(std::memory_order_relaxed))
+        while (!shutdown_requested.load(std::memory_order_relaxed)) {
+            if (parent_exited()) {
+                shutdown_requested.store(true, std::memory_order_relaxed);
+                break;
+            }
             std::this_thread::sleep_for(std::chrono::milliseconds(50));
-        if (http_server)
-            http_server->stop();
+        }
+        // httplib ignores stop() until it serves, so a shutdown asked for while the server
+        // binds or starts waits for it to serve, or for serving to end without it.
+        while (http_server && !serving_done.load(std::memory_order_relaxed)) {
+            if (http_server->running()) {
+                http_server->stop();
+                break;
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        }
     });
     ScopeExit join_shutdown_watcher([&] {
+        serving_done.store(true, std::memory_order_relaxed);
         shutdown_requested.store(true, std::memory_order_relaxed);
         if (shutdown_watcher.joinable())
             shutdown_watcher.join();
@@ -761,6 +802,7 @@ print_serve_help(const char* program) {
         "  --tls-cert FILE         TLS certificate (requires --tls-key)\n"
         "  --tls-key FILE          TLS private key\n"
         "  --no-ui                 Disable the browser playground\n"
+        "  --exit-with-parent      Stop when the process that started the server exits\n"
         "  --open                  Open the playground in the default browser\n"
         "  --http.* VALUE          Override any HTTP listener setting\n"
         "                          Realtime ASR: /v1/audio/transcriptions/realtime\n"
diff --git a/server/http/http_server.cpp b/server/http/http_server.cpp
index f87d464..591e348 100644
--- a/server/http/http_server.cpp
+++ b/server/http/http_server.cpp
@@ -1380,4 +1380,9 @@ Server::stop() {
     impl_->server->stop();
 }
 
+bool
+Server::running() const {
+    return impl_->server->is_running();
+}
+
 }  // namespace nemo_speech::http
diff --git a/server/http/http_server.h b/server/http/http_server.h
index ad67c6b..6e07126 100644
--- a/server/http/http_server.h
+++ b/server/http/http_server.h
@@ -44,6 +44,9 @@ class Server {
     Server(const Server&) = delete;
     Server& operator=(const Server&) = delete;
 
+    // True while listen_after_bind() serves; stop() has no effect before then.
+    bool running() const;
+
     // Blocks until stop() is called or the listening socket fails.
     bool listen();
     bool bind();
-- 
