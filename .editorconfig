; https://editorconfig.org/

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.swift]
indent_size = 4
max_line_length = 100

[*.md]
indent_size = 4
trim_trailing_whitespace = false

[{*.pbxproj,*.xcscheme,*.plist,*.storyboard,*.xib}]
indent_style = tab
insert_final_newline = false
trim_trailing_whitespace = false
